{#- Groups of one edition or the coming-soon text. Expects: edition, lang. -#}
{%- set groups = db.forEdition('groups', edition.year) -%}
{%- set cg = db.copy.groups -%}
{%- if groups | length %}
<div class="card-grid">
{%- for group in groups %}
  {% include "partials/group-card.njk" %}
{%- endfor %}
</div>
{%- if not edition.groupsComplete and edition.status == 'upcoming' %}
<p class="notice groups-more">{{ cg.more | t(lang) }}</p>
{%- endif %}
{%- elif edition.status == 'upcoming' %}
{%- set month = edition.announceGroups %}{%- set withMonth = cg.comingSoon %}{%- set withoutMonth = cg.comingSoonNoMonth %}{%- set vars = { year: edition.year, yearBefore: edition.year - 1 } %}
{% include "partials/coming-soon.njk" %}
{%- endif %}
