{#- Conditions of the call for applications and the apply box. Expects: edition, lang. Hidden while
    the festival runs or is over, and when the edition record carries no conditions yet. The call's
    heading and intro are not here: they sit in the page head next to the festival badge, which is
    tall enough to stand beside them (see src/pages/applications.njk). -#}
{%- set cc = db.copy.call -%}
{%- if edition.ageMin and edition.status == 'upcoming' %}
{%- set vars = { ageMin: edition.ageMin, ageMax: edition.ageMax, maxMinutes: edition.maxMinutes, maxActors: edition.maxActors, adultsMin: edition.adultsMin, adultsMax: edition.adultsMax, hosted: edition.maxActors + edition.adultsMax } %}
<section class="wrap section">
  <div class="two-col">
    <div>
      <h3>{{ cc.conditionsHeading | t(lang) }}</h3>
      <ul class="conditions">
      {%- for item in cc.conditions | t(lang) %}
        <li>{{ item | fill(vars) }}</li>
      {%- endfor %}
      </ul>
    </div>
    <div class="callout">
      {%- if edition.applyDeadline %}
      <p><strong>{{ cc.deadline | t(lang) | fill({ date: edition.applyDeadline | date(lang) }) }}</strong></p>
      {%- endif %}
      {%- if edition.call == 'open' %}
      <a class="button" href="{{ edition.applyUrl }}" rel="noopener">{{ cc.apply | t(lang) }}</a>
      {%- elif edition.call == 'closed' %}
      <p class="call-closed">{{ cc.closed | t(lang) }}</p>
      {%- elif edition.applyOpensOn %}
      <p class="call-opens">{{ cc.opensOn | t(lang) | fill({ date: edition.applyOpensOn | date(lang) }) }}</p>
      {%- else %}
      <p class="call-opens">{{ cc.opensSoon | t(lang) }}</p>
      {%- endif %}
      {%- set contact = db.applicationsContact %}
      <p class="call-contact">{{ cc.contact | t(lang) }} {{ contact.name }}, <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>{% if contact.phone %}, <a href="tel:{{ contact.phone | replace(' ', '') }}">{{ contact.phone }}</a>{% endif %}</p>
    </div>
  </div>
</section>
{%- endif %}
