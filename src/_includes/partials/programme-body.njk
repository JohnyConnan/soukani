{#- Programme of one edition: poster, schedule or coming-soon, PDF and tickets. Expects: edition, lang. -#}
{%- set slots = db.forEdition('programme', edition.year) -%}
{%- set cp = db.copy.programme -%}
<div class="two-col narrow-first">
  {% include "partials/poster.njk" %}
  <div>
    <p class="prose">{{ cp.format | t(lang) }}</p>
    {%- if slots | length %}
    {% include "partials/schedule.njk" %}
    {%- elif edition.status == 'upcoming' %}
    {%- set month = edition.announceProgramme %}{%- set withMonth = cp.comingSoon %}{%- set withoutMonth = cp.comingSoonNoMonth %}{%- set vars = { year: edition.year } %}
    {% include "partials/coming-soon.njk" %}
    {%- endif %}
    {%- if edition.programmePdf or edition.tickets %}
    <div class="callout programme-extras">
      {%- if edition.programmePdf %}
      <p><a class="button ghost" href="/{{ edition.programmePdf }}">{{ cp.pdf | t(lang) }}</a></p>
      {%- endif %}
      {%- if edition.tickets %}
      <h3>{{ cp.ticketsHeading | t(lang) }}</h3>
      <p>{{ edition.tickets | t(lang) }}</p>
      {%- if edition.ticketsUrl %}
      <p><a class="button" href="{{ edition.ticketsUrl }}" rel="noopener">{{ cp.ticketsLink | t(lang) }}</a></p>
      {%- endif %}
      {%- endif %}
    </div>
    {%- endif %}
  </div>
</div>
