{#- Landing hero. Expects: edition, lang, cta ({ href, label, external }) and dates text. -#}
<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-text">
      <h1>{{ db.site.name }}</h1>
      <p class="hero-sub">{{ db.copy.hero.edition | t(lang) | fill({ n: edition.number | ordinal(lang) }) }}</p>
      <p class="hero-dates">
        {%- if state == 'past' or state == 'archived' and edition.dateFrom -%}
          {{ db.copy.hero.past | t(lang) | fill({ dates: edition.dateFrom | range(edition.dateTo, lang) }) }}
        {%- elif edition.dateFrom -%}
          {{ edition.dateFrom | range(edition.dateTo, lang) }}
        {%- else -%}
          {{ db.copy.hero.datesTba | t(lang) }}
        {%- endif -%}
        <br><span class="place">{{ db.copy.hero.place | t(lang) }}</span>
      </p>
      {%- if cta %}
      <a class="button" href="{{ cta.href }}"{% if cta.external %} rel="noopener"{% endif %}>{{ cta.label }}</a>
      {%- endif %}
    </div>
    <div class="rings" aria-hidden="true">
      <div class="ring r1"></div>
      <div class="ring r2"></div>
      <div class="ring r3"></div>
      <div class="ring r4"></div>
      <div class="orbit o1"><span class="dot"></span><span class="dot small bottom"></span></div>
      <div class="orbit o2"><span class="dot small"></span></div>
      <div class="orbit o3"><span class="dot"></span></div>
      <div class="spider"></div>
      <div class="hero-logo"><img src="/{{ edition.logo.color }}" alt="" width="200" height="200"></div>
    </div>
  </div>
</section>
