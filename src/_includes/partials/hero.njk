{#- Landing hero. Expects: edition, lang, cta ({ href, label, external }) and dates text. -#}
<section class="hero">
  {#- Every circle draws one crop from its own pool at random on each load; --stage-pool-d1/2/3 in
      hero.css counts them and the data attributes below select them. This sits above the circles, not
      with the scripts at the end of the body, because a circle that is already parsed has its default
      crop fetched before the pick can land. The stylesheet in the head is loaded by the time an inline
      script after it runs, so the counts are readable here. Without JS every circle keeps its crop 1. -#}
  <script>
  (function () {
    var hero = document.currentScript.parentNode;
    var pools = getComputedStyle(document.documentElement);
    var circles = ["d1", "d2", "d3"];
    for (var i = 0; i < circles.length; i++) {
      var pool = parseInt(pools.getPropertyValue("--stage-pool-" + circles[i]), 10) || 1;
      hero.dataset[circles[i]] = 1 + Math.floor(Math.random() * pool);
    }
  })();
  </script>
  <div class="hero-deco" aria-hidden="true">
    <span class="deco d1"></span>
    <span class="deco d2"></span>
    <span class="deco d3"></span>
  </div>
  <div class="wrap hero-inner">
    <div class="hero-text">
      <p class="hero-eyebrow"><span class="dot" aria-hidden="true"></span>{{ db.copy.hero.badge | t(lang) | fill({ n: edition.number | ordinal(lang) }) }}</p>
      <h1>{{ db.site.name }}</h1>
      <p class="hero-sub">{{ db.copy.hero.title | t(lang) }}</p>
      <p class="hero-dates">
        {%- if (state == 'past' or state == 'archived') and edition.dateFrom -%}
          {{ db.copy.hero.past | t(lang) | fill({ dates: edition.dateFrom | range(edition.dateTo, lang) }) }}
        {%- elif edition.dateFrom -%}
          {{ edition.dateFrom | range(edition.dateTo, lang) }}
        {%- else -%}
          {{ db.copy.hero.datesTba | t(lang) }}
        {%- endif -%}
        <span class="place">{{ db.copy.hero.place | t(lang) }}</span>
      </p>
      {%- if cta %}
      <a class="button" href="{{ cta.href }}"{% if cta.external %} rel="noopener"{% endif %}>{{ cta.label }}</a>
      {%- endif %}
    </div>
    <div class="rings" aria-hidden="true">
      <div class="ring r4"></div>
      <div class="ring r3"></div>
      <div class="ring r2"></div>
      <div class="ring r1"></div>
      <div class="orbit o1"><span class="dot top"></span><span class="dot bottom"></span></div>
      <div class="orbit o2"><span class="dot left"></span></div>
      <div class="orbit os"><span class="spider"><i class="leg"></i><i class="leg"></i><i class="leg"></i><i class="leg"></i><i class="leg"></i><i class="leg"></i><i class="leg"></i><i class="leg"></i><i class="body"></i><i class="head"></i></span></div>
      {#- The band behind the rings is the accent colour, so the colour logo would sit orange on orange;
          the negative (black) variant is the one that reads here. -#}
      <div class="hero-logo"><img src="/{{ edition.logo.negative }}" alt="" width="374" height="374"></div>
    </div>
  </div>
</section>
